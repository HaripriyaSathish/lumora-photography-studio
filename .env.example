# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Studio Public Contact Channels (Configurable)
VITE_WHATSAPP_NUMBER="+919876543210"
VITE_PHONE_NUMBER="+919876543210"
VITE_CONTACT_EMAIL="hello@lumorastudio.com"

# Studio Backend Notification & Email Integration (Django / Express)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER="notifications@lumorastudio.com"
EMAIL_HOST_PASSWORD="app_specific_password_here"
DEFAULT_FROM_EMAIL="LUMORA Studio <hello@lumorastudio.com>"
CONTACT_RECEIVER_EMAIL="bookings@lumorastudio.com"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="lumora-studio"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# PostgreSQL Database URL for Django / DRF Backend
DATABASE_URL="postgres://user:password@localhost:5432/lumora_db"

